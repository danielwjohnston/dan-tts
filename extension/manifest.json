{
  "manifest_version": 3,
  "name": "dan-tts Reader",
  "version": "0.1.0",
  "description": "Read any page or selection aloud with Microsoft's natural voices, with word highlighting. No server, no account.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Read with dan-tts (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "offscreen",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://speech.platform.bing.com/*",
    "wss://speech.platform.bing.com/*"
  ],
  "commands": {
    "read": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read the selection, or the whole page"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
